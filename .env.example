# --- Seller (server) ---
# Public Base RPC (defaults to https://mainnet.base.org)
BASE_RPC_URL=https://mainnet.base.org

# HTTP listen port
PORT=4021

# Receiving address on Base mainnet (eip155:8453)
PAY_TO=0xc8aaea11c93a438e2fc7bd5cddb9a6936ed3595c

# Facilitator (mainnet verify + settle). Default: PayAI free tier — no API key.
# Alts: https://facilitator.heurist.xyz | https://v2.facilitator.mogami.tech
# Self-host later needs a gas signer via wallet (not chat).
# NEVER use https://x402.org/facilitator for real money / mainnet payTo.
FACILITATOR_URL=https://facilitator.payai.network

# Optional CDP override — only used when BOTH keys are set AND FACILITATOR_URL
# still points at api.cdp.coinbase.com (e.g. https://api.cdp.coinbase.com/platform/v2/x402).
# Create keys at https://portal.cdp.coinbase.com/ if needed later.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Free unpaid trials per client address (in-memory). Default 10.
FREE_TRIAL_LIMIT=10

# --- Buyer (smoke script) ---
# EVM private key that will pay USDC on Base (never commit real keys)
EVM_PRIVATE_KEY=

# Seller base URL for the buyer smoke script (localhost allowlisted only)
SELLER_URL=http://127.0.0.1:4021

# Optional sample address for GET /balance
QUERY_ADDRESS=0xc8aaea11c93a438e2fc7bd5cddb9a6936ed3595c
